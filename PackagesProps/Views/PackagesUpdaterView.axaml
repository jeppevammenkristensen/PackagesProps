<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:viewModel="clr-namespace:PackagesProps.ViewModels"
             x:DataType="viewModel:PackagesUpdaterViewModel"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="PackagesProps.Views.PackagesUpdaterView">
    <DockPanel LastChildFill="True">
        <!-- Header & toolbar -->
        <StackPanel DockPanel.Dock="Top" Spacing="14" Margin="0,0,0,14">
            <!-- Title -->
            <TextBlock Classes="Header" Text="{Binding Title}" />
            <TextBlock Classes="Subtitle" Text="Pick a folder to begin." />

            <!-- Toolbar -->
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Name="PickFolderButton" Content="Pick folder..." Click="PickFolderButton_OnClick" />
                <TextBlock VerticalAlignment="Center" Text="{Binding SelectedFolder}" />
                <Button Content="Refresh" Command="{Binding ExecuteRefreshCommand}" />
                <CheckBox IsChecked="{Binding Preview}" Content="Include preview"></CheckBox>
                <Button Content="Apply" Command="{Binding ApplyCommand}" />
                <ProgressBar Width="80" IsIndeterminate="True"
                             VerticalAlignment="Center"
                             ShowProgressText="False"
                             IsVisible="{Binding ExecuteRefreshCommand.IsRunning}" />
                <ProgressBar Width="80" IsIndeterminate="True"
                             VerticalAlignment="Center"
                             ShowProgressText="False"
                             IsVisible="{Binding ApplyCommand.IsRunning}" />
            </StackPanel>
        </StackPanel>

        <!-- Packages -->
        <Grid RowDefinitions="Auto,*" ColumnDefinitions="2*,*,*,*,*,*" IsEnabled="{Binding !ExecuteRefreshCommand.IsRunning}">
            <!-- Column headers -->
            <TextBlock Grid.Row="0" Grid.Column="0" FontWeight="Bold" Text="Package" Margin="8,4" />
            <TextBlock Grid.Row="0" Grid.Column="1">Package Props Version</TextBlock>
            <TextBlock Grid.Row="0" Grid.Column="2" FontWeight="Bold" Text="Installed" Margin="8,4" />
            <TextBlock Grid.Row="0" Grid.Column="3" FontWeight="Bold" Text="Available" Margin="8,4" />
            <TextBlock Grid.Row="0" Grid.Column="4" FontWeight="Bold" Text="Used" Margin="8,4" />
            <Border Grid.Row="0" Grid.ColumnSpan="6" Grid.Column="0" BorderBrush="Gray" BorderThickness="0,0,0,1" />

            <!-- Package list -->
            <ListBox Grid.Row="1" Grid.ColumnSpan="6" Grid.Column="0"
                     ItemsSource="{Binding PackageAggregateViewModels}">
                <ListBox.ItemTemplate>
                    <DataTemplate DataType="viewModel:PackageAggregateViewModel">
                        <Grid ColumnDefinitions="2*,*,*,*,*,*">
                            <TextBlock Grid.Column="0" Margin="8,4" Text="{Binding Package}" />
                            <TextBlock Grid.Column="1" Margin="8,4" Text="{Binding PackagePropsVersion}"></TextBlock>
                            <TextBlock Grid.Column="2" Margin="8,4" Text="{Binding HighestInstalledVersion}" />
                            <ComboBox Grid.Column="3" Margin="8,4" SelectedItem="{Binding HighestAvailableVersion}" ItemsSource="{Binding LatestVersions}" />
                            <TextBlock Grid.Column="4" Margin="8,4" Text="{Binding UsedVersion}" ></TextBlock>
                            <Button Grid.Column="5" Margin="8,4" Content="Refresh" Command="{Binding UseSelectedCommand}"  />
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
                <ListBox.Styles>
                    <Style Selector="ListBoxItem">
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    </Style>
                </ListBox.Styles>
            </ListBox>
        </Grid>
    </DockPanel>
</UserControl>

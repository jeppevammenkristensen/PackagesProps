<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:PackagesProps.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="560"
        x:Class="PackagesProps.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        x:Name="Main"
        Icon="/Assets/avalonia-logo.ico"
        Title="{Binding Title}" IsEnabled="{Binding Loaded}">

    <!-- Startup hook: fires StartupCommand once the window is loaded -->
    <Interaction.Behaviors>
        <EventTrigger EventName="Loaded">
            <InvokeCommandAction Command="{Binding StartupCommand}" />
        </EventTrigger>
    </Interaction.Behaviors>

    <Grid RowDefinitions="Auto,*,Auto,Auto">
        <DockPanel Grid.Row="0">
            <!-- Menu -->
            <Menu>
                <MenuItem Header="_File">
                    <MenuItem Header="Open Packages Updater" Command="{Binding LaunchPackagesUpdaterCommand}" />
                    <MenuItem Header="Open Ensure Package.props" Command="{Binding LaunchEnsurePackagePropsCommand}" />
                </MenuItem>
            </Menu>
        </DockPanel>

        <!-- Loading splash: shown until the host has finished startup -->
        <StackPanel IsVisible="{Binding !Loaded}" Grid.Row="1"
                    VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="6">
            <TextBlock Classes="Header" Text="Loading" HorizontalAlignment="Center" />
            <TextBlock Classes="Subtitle" Text="Preparing your workspace..." HorizontalAlignment="Center" />
        </StackPanel>

        <!-- Screens: one tab per open ScreenPage; ContentTemplate resolves the view via ViewLocator -->
        <TabControl
            Name="TabControl"
            IsVisible="{Binding Loaded}"
            Grid.Row="1"
            VerticalAlignment="Stretch"
            ItemsSource="{Binding Screens}"
            SelectedItem="{Binding Screen}">
            <TabControl.ItemTemplate>
                <DataTemplate>
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock Name="TabTitleTextBox" Text="{Binding Title}" VerticalAlignment="Center">
                            <TextBlock.ContextMenu>
                                <ContextMenu>
                                    <MenuItem
                                        Command="{Binding #Main.((vm:MainWindowViewModel)DataContext).CloseCommand}"
                                        CommandParameter="{Binding}"
                                        Header="Close" />
                                </ContextMenu>
                            </TextBlock.ContextMenu>
                        </TextBlock>
                        <Button Content="×"
                                Padding="2,0"
                                Background="Transparent"
                                BorderThickness="0"
                                VerticalAlignment="Center"
                                ToolTip.Tip="Close tab"
                                IsVisible="{Binding CanClose}"
                                Command="{Binding #Main.((vm:MainWindowViewModel)DataContext).CloseCommand}"
                                CommandParameter="{Binding}" />
                    </StackPanel>
                </DataTemplate>
            </TabControl.ItemTemplate>
            <TabControl.ContentTemplate>
                <DataTemplate>
                    <Border Classes="Card">
                        <ContentControl Content="{Binding}" />
                    </Border>
                </DataTemplate>
            </TabControl.ContentTemplate>
        </TabControl>

        <!-- Status bar: bound to MainWindowViewModel.Status; styling switches on StatusType -->
        <Border Grid.Row="2" Classes.StatusBar="{Binding DisplayInfo}" Classes.StatusBarRed="{Binding DisplayInfoError}">
            <TextBlock Text="{Binding Status}" />
        </Border>

        <!-- Startup progress: visible only while StartupCommand is running -->
        <ProgressBar Grid.Row="3" ShowProgressText="False"
                     IsVisible="{Binding StartupCommand.IsRunning}" IsIndeterminate="False" Minimum="0" Maximum="100"
                     Value="{Binding CurrentProgress}" />
    </Grid>
</Window>
